  },
  "bugs": "https://github.com/Lenvanderhof/Undominated.ai/issues",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "undominated-check": "bin/undominated-check.mjs"
  },
  "exports": {
    ".": "./src/verdict.mjs",
