{
  "name": "undominated-check",
  "version": "0.4.0",
  "description": "Quote published AI model verdicts and inspect or install original Undominated skills, agent profiles and its read-only MCP server.",
  "keywords": [
    "llm",
    "pricing",
    "inference",
    "openrouter",
    "cost-optimisation",
    "pareto"
  ],
  "homepage": "https://undominated.ai/check/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lenvanderhof/Undominated.ai.git",
    "directory": "packages/undominated-check"
  },
  "bugs": "https://github.com/Lenvanderhof/Undominated.ai/issues",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "undominated-check": "bin/undominated-check.mjs"
  },
  "exports": {
    ".": "./src/verdict.mjs",
    "./cli": "./src/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "resources",
    "completions"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {},
  "scripts": {
    "test": "node scripts/build-resources.mjs && node --test test/*.test.mjs",
    "prepublishOnly": "node ./prepublish.mjs",
    "resources:build": "node scripts/build-resources.mjs",
    "prepack": "node scripts/build-resources.mjs"
  }
}
