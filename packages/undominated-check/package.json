    "finops",
    "openrouter",
    "openai",
    "anthropic",
    "gemini",
    "cli",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ci"
  ],
  "homepage": "https://undominated.ai/check/",
  "bugs": {
    "url": "https://github.com/Lenvanderhof/Undominated.ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lenvanderhof/Undominated.ai.git",
    "directory": "packages/undominated-check"
  },
  "license": "MIT",
  "author": {
    "name": "Len van der Hof",
    "url": "https://lenvanderhof.com"
  },
